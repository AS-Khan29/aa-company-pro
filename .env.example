# Copy this file to .env.local for local development.
# On Vercel: Project -> Settings -> Environment Variables (add the same names).
# NEVER commit real passwords. .env.local is already git-ignored.

# Zoho SMTP login. Must be the mailbox that sends the emails.
ZOHO_SMTP_USER=info@aandacompany.com

# Zoho APP PASSWORD (not your normal login password).
# Create at: https://accounts.zoho.com -> Security -> App Passwords
ZOHO_SMTP_PASS=

# Where form submissions are delivered (defaults to ZOHO_SMTP_USER if omitted).
CONTACT_TO_EMAIL=info@aandacompany.com

# Optional. Use the host that matches your Zoho data center:
#   smtp.zoho.com (US/global, default) | smtp.zoho.eu | smtp.zoho.in | smtp.zoho.com.au | smtp.zoho.jp
ZOHO_SMTP_HOST=smtp.zoho.com
# 465 = SSL (default), 587 = STARTTLS
ZOHO_SMTP_PORT=465
